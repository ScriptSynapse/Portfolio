From 70ef794e415e23ac4e9c2f2ffc1641875f291a15 Mon Sep 17 00:00:00 2001
From: Claude <assistant@anthropic.com>
Date: Sun, 23 Aug 2026 12:23:13 +0000
Subject: [PATCH] feat: integrate Firebase (Auth, Firestore, Storage,
 Analytics)

- Add firebase SDK dependency
- Add src/lib/firebase.ts to initialize app/auth/db/storage/analytics from
  VITE_FIREBASE_* env vars (gracefully no-ops if unconfigured)
- Wire Contact form to write submissions to Firestore when configured,
  falling back to the existing Formspree endpoint otherwise
- Initialize Firebase (and Analytics support check) on app boot in main.tsx
- Document new env vars in .env.example and src/vite-env.d.ts
- Fix .gitignore: .env was not actually excluded before (only *.local was),
  so real Firebase keys could have been committed
---
 .env.example                        |   15 +-
 .gitignore                          |    3 +
 package-lock.json                   | 1078 ++++++++++++++++++++++++++-
 package.json                        |    1 +
 src/components/sections/Contact.tsx |   17 +-
 src/lib/firebase.ts                 |   44 ++
 src/main.tsx                        |    1 +
 src/vite-env.d.ts                   |    7 +
 8 files changed, 1151 insertions(+), 15 deletions(-)
 create mode 100644 src/lib/firebase.ts

diff --git a/.env.example b/.env.example
index ac97b59..7e5e41c 100644
--- a/.env.example
+++ b/.env.example
@@ -1,5 +1,16 @@
 # Optional: override the default Formspree endpoint already baked into
 # src/components/sections/Contact.tsx (https://formspree.io/f/mnjewjyp).
-# Only set this if you want to point the contact form at a different
-# Formspree form, Web3Forms, EmailJS relay, or custom API.
+# Only used as a fallback when Firebase (below) isn't configured.
 VITE_FORM_ENDPOINT= "https://formspree.io/f/mnjewjyp"
+
+# Firebase config — from Project Settings > General > "Your apps" in the
+# Firebase console (https://console.firebase.google.com). All values are
+# safe to expose client-side; access is controlled by Firestore/Storage
+# security rules, not by keeping these secret.
+VITE_FIREBASE_API_KEY=
+VITE_FIREBASE_AUTH_DOMAIN=
+VITE_FIREBASE_PROJECT_ID=
+VITE_FIREBASE_STORAGE_BUCKET=
+VITE_FIREBASE_MESSAGING_SENDER_ID=
+VITE_FIREBASE_APP_ID=
+VITE_FIREBASE_MEASUREMENT_ID=
