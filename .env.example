# ---------------------------------------------------------------------------
# Copy to .env (never commit .env — it is git-ignored).
# Only VITE_* variables are exposed to the browser. Do not put private secrets
# (admin keys, service-account JSON, SMTP passwords) in any VITE_* variable.
# ---------------------------------------------------------------------------

# Contact form fallback endpoint. Used when Firebase is not configured or a
# Firestore write fails. Defaults to the existing Formspree form if left empty.
VITE_FORM_ENDPOINT=

# Optional: Firestore delivery for the contact form (REST API — no Firebase SDK).
# Firebase web config values identify the project; access is enforced by the
# Firestore security rules in firestore.rules — deploy them before enabling.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
